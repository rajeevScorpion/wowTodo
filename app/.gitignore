# dependencies
node_modules/

# Tamagui
.tamagui/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
# Cached local-stack keys (scripts/verify-*.mjs). Local only, but the service
# role key bypasses RLS entirely — it must never be committed.
.anonkey
.servicekey

# Evaluation output (scripts/eval-voice-baseline.mjs). Synthetic utterances and
# model responses only — a run artifact, not a record. The committed record is
# docs/testing/VOICE_EVALUATION_BASELINE.md.
eval-*-results.json
eval160-results.json
