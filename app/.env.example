# WowTodo app — environment variable template.
# Copy to `.env` and fill in real values. NEVER commit the filled-in `.env`.
#
# ⚠ SECURITY NOTE — read before adding keys.
# The `EXPO_PUBLIC_` prefix causes Expo to inline these values into the built
# app bundle. Anything listed here is extractable from the installed APK by an
# end user. That is acceptable for the Supabase URL and anon key (which are
# designed to be public and are protected by Row Level Security), but it is
# NOT safe for the OpenAI and Gemini keys — those are billable credentials.
# Before the Play Store release these two should move behind a server-side
# proxy (e.g. a Supabase Edge Function) so they never ship in the client.

# Supabase project URL — safe to expose.
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anonymous key — safe to expose ONLY while RLS is correctly enforced.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI API key — used for task decomposition (gpt-4o-mini) and voice
# transcription (Whisper). BILLABLE. See security note above.
EXPO_PUBLIC_OPENAI_API_KEY=

# Google Gemini API key — fallback for task decomposition (gemini-2.0-flash).
# BILLABLE. See security note above.
EXPO_PUBLIC_GEMINI_API_KEY=
